# Runtime defaults to C:\brandai-runtime on Windows and ~/brandai-runtime on macOS.
# BRANDAI_RUNTIME_ROOT=~/brandai-runtime
# Optional worker and browser paths below are Windows workstation examples.
HF_HOME=C:\brandai-runtime\cache\huggingface
TORCH_HOME=C:\brandai-runtime\cache\torch
PLAYWRIGHT_BROWSERS_PATH=C:\brandai-runtime\cache\playwright
BRANDAI_LLAMACPP_DIR=C:\brandai-runtime\tools\llama.cpp-b12633
BRANDAI_LLM_DIR=C:\brandai-runtime\models\llm
BRANDAI_IMAGE_DIR=C:\brandai-runtime\models\image
BRANDAI_GENERATED_DIR=C:\brandai-runtime\generated
BRANDAI_LOG_DIR=C:\brandai-runtime\logs
BRANDAI_FONT_DIR=C:\brandai-runtime\fonts
# SAM 2.1 defaults to tiny and <runtime-root>/models/segmentation/sam2.
# BRANDAI_SAM2_VARIANT=sam2.1_hiera_small
# BRANDAI_SAM2_DIR=C:\brandai-runtime\models\segmentation\sam2
# Content uses deterministic stubs by default. On a provisioned Windows GPU workstation:
# BRANDAI_CONTENT_PROVIDER=local
# Disable live topic research while retaining locally cached research briefs.
# BRANDAI_TOPIC_RESEARCH=offline

