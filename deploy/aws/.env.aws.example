# Use for the loopback API and the single dedicated controller worker.
BRANDAI_RUNTIME_ROOT=/var/lib/brandai
BRANDAI_CONTENT_PROVIDER=aws
BRANDAI_TOPIC_RESEARCH=offline
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
BRANDAI_EMBEDDINGS_DIR=/var/lib/brandai/models/embeddings/multilingual-e5-base
BRANDAI_FONT_DIR=/var/lib/brandai/fonts
PLAYWRIGHT_BROWSERS_PATH=/var/lib/brandai/cache/playwright

# Attach an IAM execution role to the controller. Use a private VPC launch template.
BRANDAI_AWS_REGION=us-east-2
BRANDAI_AWS_LAUNCH_TEMPLATE_ID=lt-REPLACE_WITH_REAL_ID
BRANDAI_AWS_LAUNCH_TEMPLATE_VERSION=1
BRANDAI_AWS_DEPLOYMENT=brandai-production
BRANDAI_AWS_WORKER_PORT=8080
BRANDAI_AWS_IDLE_SECONDS=90
BRANDAI_AWS_STARTUP_SECONDS=300
BRANDAI_AWS_MAX_RUNTIME_SECONDS=3600
# Image builder only. Match the launch template's worker port.
BRANDAI_AWS_HARD_SHUTDOWN_SECONDS=4800
BRANDAI_SAM2_VARIANT=sam2.1_hiera_tiny

# Provision independently through the controller's secret manager or service environment.
# BRANDAI_OAUTH_ENCRYPTION_KEY=
# BRANDAI_META_GRAPH_VERSION=v27.0
# BRANDAI_LINKEDIN_VERSION=202609
# BRANDAI_LINKEDIN_CLIENT_ID=
# BRANDAI_LINKEDIN_CLIENT_SECRET=
# BRANDAI_SMTP_HOST=
# BRANDAI_SMTP_PORT=465
# BRANDAI_SMTP_TLS=implicit
# BRANDAI_SMTP_SENDER=
# BRANDAI_SMTP_USERNAME=
# BRANDAI_SMTP_PASSWORD=
